{
  "name": "@deepseek-ai/dsh-llm-ollama",
  "description": "Ollama (OpenAI-compatible) chat-completions adapter for the DeepSeek Harness LLM seam",
  "version": "0.1.0-rc.7",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/llm/llm-ollama"
  },
  "type": "module",
  "main": "lib/index.js",
